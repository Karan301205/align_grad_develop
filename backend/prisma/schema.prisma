datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  role      String   // "STUDENT" or "RECRUITER"
  regNo     String?  @unique
  createdAt DateTime @default(now())

  // Password Reset Fields
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  resetPasswordAttempts Int?      @default(0)
  resetPasswordWindow   DateTime?

  profile   Profile?
  company   Company?
}

model Profile {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String        @unique @db.ObjectId
  user         User          @relation(fields: [userId], references: [id])
  name         String
  username     String?
  profilePic   String?
  resumeUrl    String?
  skills       Skill[]
  tests        TestAttempt[]
  bio          String?
  nationality  String?
  gender       String?
  email        String?
  dob          String?
  phone        String?
  socialLinks  SocialLinks?
  education    Education[]
  experience   Experience[]
  certificates Certificate[]
  projects     Project[]
  cocurricular Cocurricular[]
  introVideoUrl String?
  isOnboarded   Boolean?      @default(false)
  preferredWorkModes String[] @default([])
  preferredWorkTypes String[] @default([])
  preferredLocations String[] @default([])
  openToAnyLocation  Boolean? @default(false)
}

type Cocurricular {
  activity    String?
  link        String?
  description String?
}

type Skill {
  name           String
  rating         Int
  verifiedRating Int?
}

type SocialLinks {
  linkedin         String?
  github           String?
  hackerEarth      String?
  hackerRank       String?
  codechef         String?
  leetcode         String?
  codeforces       String?
  kaggle           String?
  portfolio        String?
  showLinkedin     Boolean?
  showGithub       Boolean?
  showHackerEarth  Boolean?
  showHackerRank   Boolean?
  showCodechef     Boolean?
  showLeetcode     Boolean?
  showCodeforces   Boolean?
  showKaggle       Boolean?
  showPortfolio    Boolean?
}

type Education {
  eduType      String?
  institute    String?
  degree       String?
  fieldOfStudy String?
  startDate    String?
  endDate      String?
  gradeType    String?
  gradeValue   String?
}

type Experience {
  expType          String?
  designation      String?
  involvesTech     Boolean?
  companyName      String?
  domain           String?
  startDate        String?
  endDate          String?
  currentlyWorking Boolean?
  location         String?
  description      String?
}

type Certificate {
  title       String?
  org         String?
  startDate   String?
  link        String?
  certNumber  String?
  description String?
  attachment  String?
}

type Project {
  title            String?
  role             String?
  codeUrl          String?
  hostedUrl        String?
  startDate        String?
  endDate          String?
  currentlyWorking Boolean?
  description      String?
}

model Company {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  userId               String              @unique @db.ObjectId
  user                 User                @relation(fields: [userId], references: [id])
  name                 String
  logoUrl              String?
  description          String?
  industry             String?
  companySize          String?
  website              String?
  location             String?
  foundedYear          String?
  officialEmail        String?
  recruiterName        String?
  recruiterDesignation String?
  socialLinks          CompanySocialLinks?
  photos               String[]            @default([])
  docUrl               String?
  verified             Boolean             @default(false)
  jobs                 Job[]
}

type CompanySocialLinks {
  linkedin  String?
  twitter   String?
  github    String?
  youtube   String?
  facebook  String?
}

model Job {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId            String   @db.ObjectId
  company              Company  @relation(fields: [companyId], references: [id])
  title                String
  description          String
  companyName          String?
  opportunityType      String?  @default("JOB")
  status               String?  @default("ACTIVE")
  isPaused             Boolean? @default(false)
  officialWebsite      String?
  preferredEducation   String?
  desiredExperience    String?
  designation          String?
  stipendPartTime      String?
  stipendFullTime      String?
  duration             String?
  roleResponsibilities String?
  location             String?
  locationUrl          String?
  edited               Boolean? @default(false)
  activeDays           Int?     @default(30)
  joiningMonth         String?
  showSalary           Boolean? @default(true)
  openings             Int?
  selectionProcess     ProcessRound[]
  requirements         JobRequirement[]
  applications         Application[]
  createdAt            DateTime @default(now())
}

type ProcessRound {
  roundNumber Int
  name        String
  description String
}


type JobRequirement {
  skillName String
  minRating Int
}

type ApplicationRoundStatus {
  roundNumber Int
  name        String
  status      String   @default("PENDING")
  feedback    String?
}

model Application {
  id            String                   @id @default(auto()) @map("_id") @db.ObjectId
  jobId         String                   @db.ObjectId
  job           Job                      @relation(fields: [jobId], references: [id])
  studentId     String                   @db.ObjectId
  status        String                   @default("APPLIED")
  roundStatuses ApplicationRoundStatus[]
  createdAt     DateTime                 @default(now())
}

model TestAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId String   @db.ObjectId
  profile   Profile  @relation(fields: [profileId], references: [id])
  skillName String
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())
}

type GigRequirement {
  skillName String
  minRating Int
}

model Gig {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  description         String
  category            String?
  categories          String[]        @default([])
  skills              String[]
  requirements        GigRequirement[]
  budget              Float
  currency            String          @default("INR")
  deliveryTime        String
  logo                String?
  attachments         String[]        @default([])
  ownerId             String          @db.ObjectId
  selectedCandidateId String?         @db.ObjectId
  hiredCandidateIds   String[]        @default([]) @db.ObjectId
  status              String          @default("OPEN") // "OPEN", "IN_PROGRESS", "COMPLETED"
  minRating           Int             @default(1)
  typingUserId        String?
  createdAt           DateTime        @default(now())
  applicants          GigApplicant[]
  messages            GigMessage[]
  reviews             GigReview[]
  submissions         GigSubmission[]
}

model GigApplicant {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId       String   @db.ObjectId
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  candidateId String   @db.ObjectId
  message     String?
  attachments String[] @default([])
  createdAt   DateTime @default(now())
}

model GigMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId      String   @db.ObjectId
  gig        Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  senderId   String   @db.ObjectId
  receiverId String?  @db.ObjectId
  text       String?
  fileUrl    String?
  createdAt  DateTime @default(now())
}

model GigSubmission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId        String   @db.ObjectId
  gig          Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  candidateId  String   @db.ObjectId
  text         String?
  fileUrl      String?
  status       String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"
  createdAt    DateTime @default(now())
}

model GigReview {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId       String   @db.ObjectId
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  reviewerId  String   @db.ObjectId
  revieweeId  String   @db.ObjectId
  rating      Int
  review      String
  createdAt   DateTime @default(now())
}

model SkillDefinition {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  canonicalName       String
  slug                String   @unique
  aliases             String[]
  category            String   @default("technical")
  tier                Int      @default(3)
  status              String   @default("WAITING")
  targetQuestionCount Int      @default(300)
  counters            SkillCounters?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@index([tier, status])
}

type SkillCounters {
  totalQuestions Int @default(0)
  validated      Int @default(0)
  topicsReady    Int @default(0)
  topicsTotal    Int @default(0)
}

// Pre-generated MCQ Question Bank. Interim rows seeded by scripts/seedQuestions.js;
// the production bank (Phase 3) is generated per (skill, subtopic) from the roadmaps
// by scripts/generateQuestionBank.js and seeded by scripts/seedQuestionBank.js.
// `correctIndex` (0-3) is the server-side answer key — TestSession scores against it
// and strips it from the client payload; generateSkillTest converts it to an A-D
// letter for the current frontend. The usage/review counters are INITIALIZED here
// (Phase 3) and updated later by the assessment system (Phase 4+) — no update logic
// exists yet.
model Question {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  skillName       String
  subtopic        String
  difficulty      String    @default("Medium") // Medium | Medium-Hard | Hard
  question        String
  options         String[]
  correctIndex    Int
  explanation     String    @default("")
  tags            String[]  @default([])
  version         Int       @default(1)
  status          String    @default("ACTIVE") // ACTIVE | RETIRED | FLAGGED (service inclusion; only ACTIVE is served)
  reviewState     String    @default("NONE")   // NONE | NEEDS_REVIEW | REPLACEMENT_CANDIDATE (Phase 5 maintenance flag; the question stays ACTIVE & servable until a replacement is approved)
  source          String    @default("temp-bank-groq")
  usageCount      Int       @default(0)
  correctCount    Int       @default(0)
  wrongCount      Int       @default(0)
  skipCount       Int       @default(0)
  lastUsed        DateTime?
  lastReviewed    DateTime?
  lastRegenerated DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([skillName])
  @@index([skillName, subtopic])
  @@index([skillName, status]) // hot path: assessment selection (findActiveBySkill) filters skillName + status=ACTIVE
  @@index([status])
  @@index([reviewState])
}

// Server-side assessment session. Holds the answer key so the client is never
// sent it and never supplies its own score. Single-use and expiring:
// `generateSkillTest` creates one (used=false); `submitSkillTest` scores the
// submitted answers against `answerKey`, then marks it used. `answerKey[i]` is
// the correct option index (0-3) for served question i.
model TestSession {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  skillName   String
  answerKey   Int[]
  questionIds String[] @default([]) // served Question ids, parallel to answerKey; drives per-question usage tracking in submitSkillTest (Phase 4)
  used        Boolean  @default(false)
  score       Int?
  passed      Boolean?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
}

// Assessment-level analytics (Phase 5). One immutable record per completed
// assessment, written by submitSkillTest. Feeds future recruiter reporting /
// dashboards (built in a later phase). Never deleted — historical data is
// preserved. `questionIds` records exactly which bank questions were served.
model AssessmentRecord {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  candidateId       String   @db.ObjectId
  skill             String
  questionIds       String[]
  startedAt         DateTime
  endedAt           DateTime
  totalQuestions    Int
  correctAnswers    Int
  wrongAnswers      Int
  skippedQuestions  Int
  finalScore        Int      // percentage 0-100
  passed            Boolean
  createdAt         DateTime @default(now())

  @@index([candidateId])
  @@index([skill])
}

// Interview roadmap ("blueprint") for a technical skill: the ordered syllabus of
// subtopics that later drives question generation (Phase 2). One record per
// canonical skill from the registry. `popularityRank` (1 = highest hiring demand)
// sets the order skills are generated in; `subtopics` are ordered foundational ->
// advanced. Generated offline (Bedrock Claude -> Groq fallback), seeded by
// scripts/seedRoadmaps.js. No MCQs are stored here.
model SkillRoadmap {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  skillName      String   @unique
  popularityRank Int
  subtopics      String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([popularityRank])
}

// --- Community System Models ---

model Community {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  logo         String?
  banner       String?
  type         String   @default("PRIVATE") // "GLOBAL" | "PRIVATE"
  passwordHash String?
  ownerId      String   @db.ObjectId
  deleted      Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([deleted])
}

model CommunityMember {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  communityId String   @db.ObjectId
  userId      String   @db.ObjectId
  role        String   @default("MEMBER") // "OWNER" | "ADMIN" | "MEMBER" | "MODERATOR"
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model CommunityInvite {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  communityId    String    @db.ObjectId
  token          String    @unique
  expirationDate DateTime?
  maxUses        Int?
  useCount       Int       @default(0)
  isActive       Boolean   @default(true)
  createdById    String    @db.ObjectId
  createdAt      DateTime  @default(now())

  @@index([communityId])
}

model Post {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  authorId    String    @db.ObjectId
  authorRole  String    // "STUDENT" | "RECRUITER"
  communityId String    @db.ObjectId
  content     String
  postType    String    @default("TEXT") // "TEXT" | "IMAGE" | "MULTI_IMAGE" | "VIDEO" | "PDF"
  edited      Boolean   @default(false)
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([communityId, createdAt])
  @@index([authorId])
  @@index([deleted])
}

model Media {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  postId          String   @db.ObjectId
  s3Key           String
  url             String
  mediaType       String   // "IMAGE" | "VIDEO" | "PDF" | "THUMBNAIL"
  mimeType        String
  sizeBytes       Int
  durationSeconds Int?
  width           Int?
  height          Int?
  createdAt       DateTime @default(now())

  @@index([postId])
}

model PostReaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  userId    String   @db.ObjectId
  type      String   // "LIKE" | "LOVE" | "CELEBRATE" | "INSIGHTFUL" | "SUPPORT" | "FUNNY"
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostComment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  postId          String    @db.ObjectId
  authorId        String    @db.ObjectId
  authorRole      String    // "STUDENT" | "RECRUITER"
  parentCommentId String?   @db.ObjectId
  content         String
  deleted         Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([parentCommentId])
}

model SavedPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  postId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
}

model PostView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}
