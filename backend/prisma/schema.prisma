datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  role      String   // "STUDENT" or "RECRUITER"
  regNo     String?  @unique
  createdAt DateTime @default(now())
  profile   Profile?
  company   Company?
}

model Profile {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String        @unique @db.ObjectId
  user         User          @relation(fields: [userId], references: [id])
  name         String
  username     String?
  profilePic   String?
  resumeUrl    String?
  skills       Skill[]
  tests        TestAttempt[]
  bio          String?
  nationality  String?
  gender       String?
  email        String?
  dob          String?
  phone        String?
  socialLinks  SocialLinks?
  education    Education[]
  experience   Experience[]
  certificates Certificate[]
  projects     Project[]
  cocurricular Cocurricular[]
  introVideoUrl String?
  isOnboarded   Boolean?      @default(false)
}

type Cocurricular {
  activity    String?
  link        String?
  description String?
}

type Skill {
  name           String
  rating         Int
  verifiedRating Int?
}

type SocialLinks {
  linkedin         String?
  github           String?
  hackerEarth      String?
  hackerRank       String?
  codechef         String?
  leetcode         String?
  codeforces       String?
  kaggle           String?
  portfolio        String?
  showLinkedin     Boolean?
  showGithub       Boolean?
  showHackerEarth  Boolean?
  showHackerRank   Boolean?
  showCodechef     Boolean?
  showLeetcode     Boolean?
  showCodeforces   Boolean?
  showKaggle       Boolean?
  showPortfolio    Boolean?
}

type Education {
  eduType      String?
  institute    String?
  degree       String?
  fieldOfStudy String?
  startDate    String?
  endDate      String?
  gradeType    String?
  gradeValue   String?
}

type Experience {
  expType          String?
  designation      String?
  involvesTech     Boolean?
  companyName      String?
  domain           String?
  startDate        String?
  endDate          String?
  currentlyWorking Boolean?
  location         String?
  description      String?
}

type Certificate {
  title       String?
  org         String?
  startDate   String?
  link        String?
  certNumber  String?
  description String?
  attachment  String?
}

type Project {
  title            String?
  role             String?
  codeUrl          String?
  hostedUrl        String?
  startDate        String?
  endDate          String?
  currentlyWorking Boolean?
  description      String?
}

model Company {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  userId               String              @unique @db.ObjectId
  user                 User                @relation(fields: [userId], references: [id])
  name                 String
  logoUrl              String?
  description          String?
  industry             String?
  companySize          String?
  website              String?
  location             String?
  foundedYear          String?
  officialEmail        String?
  recruiterName        String?
  recruiterDesignation String?
  socialLinks          CompanySocialLinks?
  photos               String[]            @default([])
  docUrl               String?
  verified             Boolean             @default(false)
  jobs                 Job[]
}

type CompanySocialLinks {
  linkedin  String?
  twitter   String?
  github    String?
  youtube   String?
  facebook  String?
}

model Job {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId            String   @db.ObjectId
  company              Company  @relation(fields: [companyId], references: [id])
  title                String
  description          String
  companyName          String?
  opportunityType      String?  @default("JOB")
  officialWebsite      String?
  preferredEducation   String?
  desiredExperience    String?
  designation          String?
  stipendPartTime      String?
  stipendFullTime      String?
  duration             String?
  roleResponsibilities String?
  location             String?
  locationUrl          String?
  edited               Boolean? @default(false)
  activeDays           Int?     @default(30)
  joiningMonth         String?
  openings             Int?
  selectionProcess     ProcessRound[]
  requirements         JobRequirement[]
  applications         Application[]
  createdAt            DateTime @default(now())
}

type ProcessRound {
  roundNumber Int
  name        String
  description String
}


type JobRequirement {
  skillName String
  minRating Int
}

type ApplicationRoundStatus {
  roundNumber Int
  name        String
  status      String   @default("PENDING")
  feedback    String?
}

model Application {
  id            String                   @id @default(auto()) @map("_id") @db.ObjectId
  jobId         String                   @db.ObjectId
  job           Job                      @relation(fields: [jobId], references: [id])
  studentId     String                   @db.ObjectId
  status        String                   @default("APPLIED")
  roundStatuses ApplicationRoundStatus[]
  createdAt     DateTime                 @default(now())
}

model TestAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId String   @db.ObjectId
  profile   Profile  @relation(fields: [profileId], references: [id])
  skillName String
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())
}

model Gig {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  description         String
  skills              String[]
  budget              Float
  deliveryTime        String
  attachments         String[]        @default([])
  ownerId             String          @db.ObjectId
  selectedCandidateId String?         @db.ObjectId
  status              String          @default("OPEN") // "OPEN", "IN_PROGRESS", "COMPLETED"
  typingUserId        String?
  createdAt           DateTime        @default(now())
  applicants          GigApplicant[]
  messages            GigMessage[]
  reviews             GigReview[]
  submissions         GigSubmission[]
}

model GigApplicant {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId       String   @db.ObjectId
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  candidateId String   @db.ObjectId
  message     String?
  createdAt   DateTime @default(now())
}

model GigMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId     String   @db.ObjectId
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  senderId  String   @db.ObjectId
  text      String?
  fileUrl   String?
  createdAt DateTime @default(now())
}

model GigSubmission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId        String   @db.ObjectId
  gig          Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  candidateId  String   @db.ObjectId
  text         String?
  fileUrl      String?
  status       String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"
  createdAt    DateTime @default(now())
}

model GigReview {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  gigId       String   @db.ObjectId
  gig         Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  reviewerId  String   @db.ObjectId
  revieweeId  String   @db.ObjectId
  rating      Int
  review      String
  createdAt   DateTime @default(now())
}

model SkillDefinition {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  canonicalName       String
  slug                String   @unique
  aliases             String[]
  category            String   @default("technical")
  tier                Int      @default(3)
  status              String   @default("WAITING")
  targetQuestionCount Int      @default(300)
  counters            SkillCounters?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@index([tier, status])
}

type SkillCounters {
  totalQuestions Int @default(0)
  validated      Int @default(0)
  topicsReady    Int @default(0)
  topicsTotal    Int @default(0)
}

// Pre-generated MCQ bank. Seeded offline by scripts/seedQuestions.js.
// `correctIndex` (0-3) is the server-side answer key — Plan 2's TestSession will
// score against it and strip it from the client payload. The interim serve path
// (generateSkillTest) still converts it to an A-D letter for the current frontend.
model Question {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  skillName    String
  subtopic     String
  question     String
  options      String[]
  correctIndex Int
  source       String   @default("temp-bank-groq")
  createdAt    DateTime @default(now())

  @@index([skillName])
}

// Server-side assessment session. Holds the answer key so the client is never
// sent it and never supplies its own score. Single-use and expiring:
// `generateSkillTest` creates one (used=false); `submitSkillTest` scores the
// submitted answers against `answerKey`, then marks it used. `answerKey[i]` is
// the correct option index (0-3) for served question i.
model TestSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  skillName String
  answerKey Int[]
  used      Boolean  @default(false)
  score     Int?
  passed    Boolean?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}
