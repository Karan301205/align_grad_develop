# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection (the app builds the URL from these; special characters in the
# password are fine — they are URL-encoded automatically). DB_PORT defaults to 5432.
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-database
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SCHEMA=align_grap_test

# ─── Authentication ─────────────────────────────────────────
# Secret key for signing JWT tokens
JWT_SECRET="your_jwt_secret_here"

# ─── Server ─────────────────────────────────────────────────
PORT=5001

# ─── Frontend Client Origin ─────────────────────────────────
# Base URL of the client frontend for password reset links and CORS
# Local development: http://localhost:5173
# Production: https://career.yourdomain.com
CLIENT_URL="http://localhost:5173"
# Optional: sign-in pages per role for the button in support emails, when candidates and
# recruiters use separate hosts. Empty → CLIENT_URL.
CANDIDATE_PORTAL_URL=""
RECRUITER_PORTAL_URL=""

# ─── AWS S3 Storage ─────────────────────────────────────────
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="your_s3_bucket_name_here"

# ─── CloudFront (course lesson videos and documents) ───────
# Links are signed with the CloudFront key pair; without a usable key the course API
# answers 503 instead of a link CloudFront would refuse. Give the private key EITHER
# as a file (absolute, or relative to main_website/backend; *.pem is gitignored, so a
# server deployed from git needs the file copied there) OR as its text in
# CLOUDFRONT_PRIVATE_KEY (one line is fine: write newlines as \n). The text wins.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=../../cloudfront_private_key.pem
# CLOUDFRONT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# ─── AI / LLM APIs ─────────────────────────────────────────
# Groq API key (used for skill-based AI features)
GROQ_API_KEY="your_groq_api_key_here"

# Claude / Anthropic API key (used for resume analysis)
CLAUDE_API_KEY="your_claude_api_key_here"

# ─── Email Service (Gmail / SMTP) ───────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_smtp_app_password_here"
SMTP_FROM_NAME="AlignGrad Team"

# ─── Razorpay Payment Gateway ───────────────────────────────
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# ─── Supabase (Optional: legacy intro video uploads) ────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# ─── Redis (optional) ───────────────────────────────────────
# When set, OTP emails go through a queue (BullMQ) and are retried if sending fails.
# Leave empty to send emails directly, as before.
REDIS_URL=""
# Emails sent at the same time (also the number of open mail-server connections).
# EMAIL_QUEUE_CONCURRENCY=5
# EMAIL_QUEUE_ATTEMPTS=3

# ─── Job lifecycle (optional, defaults shown) ───────────────
# Longest listing a recruiter can choose (days).
# JOB_MAX_ACTIVE_DAYS=90
# Days after a job closes before its long details are removed.
# JOB_ARCHIVE_AFTER_DAYS=30
# Days after that before the job and its non-hired applications are deleted.
# JOB_DELETE_AFTER_DAYS=365

# ─── Google sign-in ─────────────────────────────────────────
# OAuth client ID. Google sign-in is refused until this is set. Use the same value as VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=""

