# ─── Database ───────────────────────────────────────────────
# MongoDB connection string (local or Atlas replica set)
DATABASE_URL="mongodb://localhost:27017/align_grade?replicaSet=rs0"

# ─── Authentication ─────────────────────────────────────────
# Secret key for signing JWT tokens
JWT_SECRET="your_jwt_secret_here"

# ─── Server ─────────────────────────────────────────────────
PORT=5001

# ─── Frontend Client Origin ─────────────────────────────────
# Base URL of the client frontend for password reset links and CORS
# Local development: http://localhost:5173
# Production: https://career.yourdomain.com
CLIENT_URL="http://localhost:5173"

# ─── AWS S3 Storage ─────────────────────────────────────────
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="your_s3_bucket_name_here"

# ─── AI / LLM APIs ─────────────────────────────────────────
# Groq API key (used for skill-based AI features)
GROQ_API_KEY="your_groq_api_key_here"

# Claude / Anthropic API key (used for resume analysis)
CLAUDE_API_KEY="your_claude_api_key_here"

# ─── Email Service (Gmail / SMTP) ───────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_smtp_app_password_here"
SMTP_FROM_NAME="AlignGrad Team"

# ─── Razorpay Payment Gateway ───────────────────────────────
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# ─── Supabase (Optional: legacy intro video uploads) ────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

