# ─── Backend API ─────────────────────────────────────────────
# Base URL for the Main AlignGrade Express Backend (default port 5001)
# Local development: http://localhost:5001/api
# Production: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:5001/api

# ─── Authentication ─────────────────────────────────────────
# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Multi-Portal Domain Routing (Optional) ─────────────────
# Set these URLs when deploying candidate, recruiter, and landing portals across separate domains/subdomains.
# Leave commented or blank for local single-origin development (port 5173).
# VITE_LANDING_URL=https://yourdomain.com
# VITE_CANDIDATE_URL=https://career.yourdomain.com
# VITE_RECRUITER_URL=https://hire.yourdomain.com

# ─── Supabase (Optional: intro video uploads in StudentShowcase) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

