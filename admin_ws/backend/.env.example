# Recruiter verification decision emails (SMTP, e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
