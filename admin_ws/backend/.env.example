# Administrative Backend Configuration
PORT=5002
ADMIN_FRONTEND_URL=http://localhost:5174
# PostgreSQL connection (the app builds the URL from these; special characters in the
# password are fine — they are URL-encoded automatically). DB_PORT defaults to 5432.
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-database
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SCHEMA=align_grap_test
JWT_SECRET=your_jwt_secret_key_here
REDIS_URL=redis://localhost:6379
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_BASE_URL=https://your_s3_bucket_name.s3.ap-south-1.amazonaws.com

# Recruiter verification decision emails (SMTP, e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM_NAME=AlignGrad
# Recruiter login page linked from approval/rejection emails
RECRUITER_PORTAL_URL=http://localhost:5173/recruiter/login
# Candidate sign-in page linked from support emails to candidates (optional)
CANDIDATE_PORTAL_URL=http://localhost:5173/candidate/login
